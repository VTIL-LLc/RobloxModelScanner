<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    ============================================================================
    RMS CONFIGURATION CONSOLE - WEBSITE CONFIGURATION
    ============================================================================
    This file is committed, so it must not carry a secret.

    The site reads one program: the Configuration service, which runs on the same
    machine and answers over loopback. It presents a shared key that this file
    does not hold: the key is supplied by the deployment, either as
    SITE_SERVICE_KEY or, preferably, as the contents of the file named by
    SITE_SERVICE_KEY_FILE. The header the key travels in is set here, because this
    site reaches a different program from the other consoles and a key presented
    to the wrong service is a key that has been written into somebody else's log.

    Every setting below can be overridden with an environment variable of the same
    name prefixed with SITE_, so a deployment can change behaviour without editing
    a file that is under version control.

    The account database lives in App_Data, which IIS does not serve. It holds this
    site's own accounts and the audit trail, and nothing else: the service is
    stateless and this site keeps no copy of any manifest.
  -->
  <appSettings>
    <!--
      The names shown in the browser tab and the navbar. The brand is the shorter of the two, so a deployment
      with three consoles in three tabs can tell them apart by the first word alone.
    -->
    <add key="SiteTitle" value="RMS Configuration" />
    <add key="SiteBrand" value="RMS Configuration" />

    <!--
      The Configuration service. Bound to loopback because it can write the files a
      deployment is described by; a deployment that puts something in front of it
      changes this address, not the service.
    -->
    <add key="SiteServiceBaseUrl" value="http://127.0.0.1:5202" />

    <!--
      The header the shared key travels in. Named for the service it is presented to,
      so that a key file for one console cannot be quietly accepted by another, and
      so that a service's own log says which surface was called.
    -->
    <add key="SiteServiceKeyHeader" value="X-Configuration-Key" />

    <!-- Intentionally empty. Supply the real key through SITE_SERVICE_KEY, or
         SITE_SERVICE_KEY_FILE, or let the deployer write the key file's path
         into SiteServiceKeyFile below. -->
    <add key="SiteServiceKey" value="" />

    <!-- The absolute path of a file holding the key, written here by rmsdeploy
         when this site is deployed. A path is not a secret: the file it names is,
         and that file lives outside the web root, so no part of the key is ever
         inside a directory IIS serves. A file named here is preferred to a key
         written above. Left empty, the site still starts and refuses its own
         service, which is the safe direction to fail in. -->
    <add key="SiteServiceKeyFile" value="" />

    <!-- A single call may spend this long before the page says the service is slow. -->
    <add key="SiteServiceTimeoutSeconds" value="20" />

    <!--
      How often the live regions of a page refresh themselves. Slower than the
      operations console, because these pages describe files on disk that change when
      somebody edits them rather than processes that change by themselves.
    -->
    <add key="SiteRefreshSeconds" value="30" />

    <!--
      Sign-in policy. The iteration count is stored with each password hash, so
      raising it here does not lock anybody out: the next successful sign-in
      re-derives the hash at the new count.
    -->
    <add key="SitePasswordIterations" value="210000" />
    <add key="SiteMaximumFailedAttempts" value="8" />
    <add key="SiteLockoutMinutes" value="15" />
    <add key="SiteSessionMinutes" value="480" />

    <!--
      requireSSL stays false so the site also runs on a plain HTTP bind, which is
      how it is served behind the reverse proxy and how it is developed. A
      deployment reached directly over TLS turns it on.
    -->
    <add key="SiteRequireHttps" value="false" />
  </appSettings>

  <system.web>
    <!--
      Debug compilation is off so that a compile-time failure is never rendered
      to a remote caller, and so that a deployed site serves its precompiled
      build rather than compiling on the first hit.
    -->
    <compilation debug="false" targetFramework="4.8" batch="true" optimizeCompilations="true" />
    <httpRuntime targetFramework="4.8"
                 requestValidationMode="2.0"
                 enableVersionHeader="false"
                 maxRequestLength="4096"
                 executionTimeout="120" />

    <!--
      Assemblies are loaded from bin rather than from a shadow copy.

      This is not an optimisation. The SQLite provider finds its native library by looking beside
      the assemblies that make it up, and a shadow copy is a directory that holds assemblies and
      nothing else: the native library stays in bin\runtimes\<platform>\native and the provider
      never looks there. Loading from bin settles that, and it settles it for every other library
      that has ever tried to reason about where it is loaded from.

      The cost is that bin is locked while the site is running, so replacing binaries means stopping
      the site first, which the deployment already does, and which is what happens on any host that
      does not shadow-copy.
    -->
    <hostingEnvironment shadowCopyBinAssemblies="false" />

    <!--
      Forms authentication. Sign-in is performed by this site's own pages against
      the account table in App_Data; the forms cookie is only the envelope the
      account identifier travels in, and the account is re-read on every request,
      so disabling an account takes effect on the next click. The cookie is
      encrypted and HTTP-only, and sameSite=Lax keeps a cross-site request from
      carrying it. The name is distinct from every other console's, because they
      are commonly served from names that share a parent domain.
    -->
    <authentication mode="Forms">
      <forms name=".RMSCONFIG"
             loginUrl="~/Account/Login.aspx"
             defaultUrl="~/Default.aspx"
             timeout="480"
             slidingExpiration="true"
             protection="All"
             requireSSL="false"
             cookieless="UseCookies" />
    </authentication>

    <!-- Everything requires a session unless a location below says otherwise. -->
    <authorization>
      <deny users="?" />
    </authorization>

    <httpCookies httpOnlyCookies="true" sameSite="Lax" requireSSL="false" />

    <sessionState mode="InProc" cookieless="UseCookies" timeout="480" />

    <!--
      View state is off for the whole application. These pages contain no server
      controls: every one renders its document itself and every live region is
      refreshed by fetching markup, so there is no control state to round-trip.
      Removing it deletes the view-state surface, shrinks every response, and
      drops the postback bootstrap script that would otherwise force a weaker
      script content security policy than the one these pages are served under.
    -->
    <pages enableViewState="false"
           enableViewStateMac="true"
           enableEventValidation="true"
           validateRequest="true"
           autoEventWireup="false"
           maintainScrollPositionOnPostBack="false" />

    <!-- A remote caller sees a generic page; a local request sees the real error. -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" redirectMode="ResponseRedirect" />
  </system.web>

  <!--
    The sign-in page, its logout and the error page are reachable before a ticket
    exists. Static assets are served by the IIS static handler and are not subject
    to URL authorization, but the rules are declared anyway so that the intent is
    explicit and a managed-pipeline configuration cannot lock them out.
  -->
  <location path="Account/Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Account/Logout.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Error.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!--
    Request validation is off for the editor and nowhere else.

    The editor posts the whole of a manifest back as one value, and a manifest is a
    file somebody wrote: a comment containing an angle bracket is ordinary, and the
    framework would refuse the post with a message about a dangerous value, losing
    everything the operator typed. Nothing here renders a posted value as markup:
    the text goes to the service as JSON, and every value that comes back is encoded
    by the renderer. The rule that keeps the aspx safe is that no page ever writes a
    request value into a response without encoding it, and that rule holds on every
    other page of this site too.

    It is declared here rather than on the page alone because the page-level
    attribute is only honoured when the runtime is configured to honour it. The
    runtime is set to the mode in which validation is applied to the whole request
    for every page and a page may opt out, which is the only mode where a single
    page can be exempted: the newer mode validates request values as they are read
    and has no per-page opt-out at all, so the editor would throw the moment it read
    the text it was sent.
  -->
  <location path="Editor.aspx">
    <system.web>
      <pages validateRequest="false" />
    </system.web>
  </location>

  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <!--
          A defence that costs nothing to have in two places. The pages write the
          same policy as a meta element, which travels with the document; these
          headers travel with the response, and one of the two arriving is enough.
        -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="same-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=(), payment=()" />
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- Refuse oversized or unusually deep requests before they reach the pipeline. -->
        <requestLimits maxAllowedContentLength="2097152" maxUrl="4096" maxQueryString="2048" />
        <hiddenSegments>
          <!--
            App_Data holds the credential database. The entry is removed before
            it is added because IIS already hides App_Data by default, and adding
            it a second time is a duplicate collection entry, which stops the
            application from starting at all.
          -->
          <remove segment="App_Data" />
          <add segment="App_Data" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>

</configuration>
