<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    ============================================================================
    RMS MODEL SCANNER - WEBSITE CONFIGURATION
    ============================================================================
    This file is committed, so it must not carry a secret.

    The site reads one program: the scanner's API, which runs on this machine and
    answers over loopback. It presents a shared key that this file does not hold. The
    key is supplied by the deployment, either as SITE_SERVICE_KEY or,
    preferably, as the contents of the file named by SITE_SERVICE_KEY_FILE.

    The key travels in the query, not in a header, and that is stated here rather
    than left to the default. The API's published contract reads its key from an
    apiKey query parameter, and the site's client presents a key in exactly one
    place: when a query parameter is configured it is used, and the header is not
    sent at all. Declaring both would be declaring a key that travels twice and is
    logged twice.

    Every setting below can be overridden with an environment variable of the same
    name prefixed with SITE_, so a deployment can change behaviour without editing
    a file that is under version control.

    The account database lives in App_Data, which IIS does not serve. It holds this
    site's own accounts, the notices shown at the top of every page and the audit
    trail. It holds no part of the catalogue: the catalogue is the API's, and this
    site keeps no copy of it.
  -->
  <appSettings>
    <!--
      The names shown in the browser tab and the navbar. The brand is the shorter of
      the two, so a deployment running several consoles can tell them apart by the
      first word alone.
    -->
    <add key="SiteTitle" value="RMS Model Scanner" />
    <add key="SiteBrand" value="RMS Scanner" />

    <!--
      The scanner's API. This is the address the API is started on by the deployment;
      a deployment that puts something in front of it changes this address, not the
      API. It has to agree with the API's own ASPNETCORE_URLS in
      deploy/rmsdeploy.services, or the site answers every page with the outage view
      while the API it cannot reach runs perfectly well beside it.
    -->
    <add key="SiteServiceBaseUrl" value="http://127.0.0.1:5000" />

    <!--
      The query parameter the key travels in. Named apiKey because that is the name
      the API's own contract reads, and it is not ours to change: the API is published
      to callers that already send it that way.
    -->
    <add key="SiteServiceKeyQueryParameter" value="apiKey" />

    <!--
      The header the key would travel in, named here so that the file says which
      surface this site belongs to. It is not sent while the query parameter above is
      set, and naming it something other than the default keeps a key file prepared
      for another console from being silently accepted by this one if that ever
      changes.
    -->
    <add key="SiteServiceKeyHeader" value="X-Scanner-Key" />

    <!-- Intentionally empty. Supply the real key through SITE_SERVICE_KEY, or
         SITE_SERVICE_KEY_FILE, or let the deployer write the key file's path
         into SiteServiceKeyFile below. -->
    <add key="SiteServiceKey" value="" />

    <!-- The absolute path of a file holding the key, written here by rmsdeploy
         when this site is deployed. A path is not a secret: the file it names is,
         and that file lives outside the web root, so no part of the key is ever
         inside a directory IIS serves. A file named here is preferred to a key
         written above. Left empty, the site still starts and refuses its own
         service, which is the safe direction to fail in. -->
    <add key="SiteServiceKeyFile" value="" />

    <!--
      A single call may spend this long before the page says the API is slow. Longer
      than the other consoles allow, because resolving a download address makes
      Roblox's own delivery service do the work.
    -->
    <add key="SiteServiceTimeoutSeconds" value="25" />

    <!--
      How often the live regions of a page refresh themselves. The catalogue changes
      when a scan finishes rather than continuously, so there is nothing to gain from
      asking more often than this.
    -->
    <add key="SiteRefreshSeconds" value="15" />

    <!--
      Sign-in policy. The iteration count is stored with each password hash, so raising
      it here does not lock anybody out: the next successful sign-in re-derives the
      hash at the new count.
    -->
    <add key="SitePasswordIterations" value="210000" />
    <add key="SiteMaximumFailedAttempts" value="8" />
    <add key="SiteLockoutMinutes" value="15" />
    <add key="SiteSessionMinutes" value="480" />

    <!--
      requireSSL stays false so the site also runs on a plain HTTP bind, which is how
      it is served on an internal network and how it is developed. A deployment
      reached over TLS turns it on.
    -->
    <add key="SiteRequireHttps" value="false" />
  </appSettings>

  <system.web>
    <!--
      Debug compilation is off so that a compile-time failure is never rendered to a
      remote caller, and so that a deployed site serves its precompiled build rather
      than compiling on the first hit.
    -->
    <compilation debug="false" targetFramework="4.8" batch="true" optimizeCompilations="true" />
    <httpRuntime targetFramework="4.8"
                 requestValidationMode="2.0"
                 enableVersionHeader="false"
                 maxRequestLength="4096"
                 executionTimeout="120" />

    <!--
      Assemblies are loaded from bin rather than from a shadow copy.

      This is not an optimisation. The SQLite provider finds its native library by
      looking beside the assemblies that make it up, and a shadow copy is a directory
      that holds assemblies and nothing else: the native library stays in
      bin\runtimes\<platform>\native and the provider never looks there. Loading from
      bin settles that, and it settles it for every other library that has ever tried
      to reason about where it is loaded from.

      The cost is that bin is locked while the site is running, so replacing binaries
      means stopping the site first, which the deployment already does.
    -->
    <hostingEnvironment shadowCopyBinAssemblies="false" />

    <!--
      Forms authentication. Sign-in is performed by this site's own pages against the
      account table in App_Data; the cookie is only the envelope the account
      identifier travels in, and the account is re-read on every request, so disabling
      an account takes effect on the next click. The cookie is encrypted and
      HTTP-only, and sameSite=Lax keeps a cross-site request from carrying it.
    -->
    <authentication mode="Forms">
      <forms name=".SCANNER"
             loginUrl="~/Account/Login.aspx"
             defaultUrl="~/Default.aspx"
             timeout="480"
             slidingExpiration="true"
             protection="All"
             requireSSL="false"
             cookieless="UseCookies" />
    </authentication>

    <!--
      This file states no authorization section at its own root, and that is
      deliberate. The deny that used to stand here is stated once, in the location
      for the application root further down, because the rule that covers a request
      for the front door has to be the rule in that location: a path of "." in a
      location is the application root, so a deny written here and a deny written
      there are the same section twice over, which the configuration system refuses
      outright. Read that location for what the site answers and in which order it
      decides.
    -->
    <httpCookies httpOnlyCookies="true" sameSite="Lax" requireSSL="false" />

    <sessionState mode="InProc" cookieless="UseCookies" timeout="480" />

    <!--
      View state is off for the whole application. These pages contain no server
      controls: every one renders its document itself and every live region is
      refreshed by fetching markup, so there is no control state to round-trip.
      Removing it deletes the view-state surface, shrinks every response, and drops
      the postback bootstrap script that would otherwise force a weaker script
      content security policy than the one these pages are served under.
    -->
    <pages enableViewState="false"
           enableViewStateMac="true"
           enableEventValidation="true"
           validateRequest="true"
           autoEventWireup="false"
           maintainScrollPositionOnPostBack="false" />

    <!-- A remote caller sees a generic page; a local request sees the real error. -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" redirectMode="ResponseRedirect" />
  </system.web>

  <!--
    The sign-in page, its logout and the error page are reachable before a ticket
    exists. Static assets are served by the IIS static handler and are not subject to
    URL authorization, but the rules are declared anyway so that the intent is
    explicit and a managed-pipeline configuration cannot lock them out.
  -->
  <location path="Account/Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Account/Logout.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Error.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!--
    The two handlers a visitor's browser calls.

    A location is named for a file rather than for a directory, so each of these
    opens exactly one address and nothing beneath it. What each handler may be asked
    for is decided inside it: the fragment handler builds the catalogue and a model's
    regions for anybody and refuses the analytics and the rule reference without a
    session, and the download handler resolves an address through the API, which is
    where this site's key lives and never leaves.

    The two pages those handlers belong to, the catalogue and a model's page, are
    opened further down, in the same location elements that exempt them from request
    validation.
  -->
  <location path="Api/Download.ashx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Api/Fragment.ashx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!--
    The application root, and with it every address that no more specific location
    names.

    A path of "." matches everything in the application, and a location that names a
    file or a directory overrides it for that address alone, so this is where the
    site's default lives: a visitor without a session who asks for something the
    locations below do not open is refused by the request pipeline, before any of the
    site's code runs, and is sent to the sign-in form because the page never got the
    chance to answer for itself.

    The one address this table does not name is the front door. A request for "/" is
    authorized while its path is still "/": the default document is applied to the
    path further down the pipeline, after the authorization step, so a rule written
    for Default.aspx does not cover the address that reaches it. It cannot be named
    here either, because that address is this node: a location spelled "/", or one
    spelled "*", or the deny itself written into the application's own section, are
    all this same section, and the configuration system refuses the file when it is
    stated twice. The exception is therefore stated by the application as the request
    arrives, which is where the site says that its front door is the catalogue; see
    Application_AuthenticateRequest in Global.asax.cs. Everything else about this
    table still holds, and a request for any other address is still refused here.

    The site's public face is the set of locations that name themselves over this
    one: the front door and the catalogue page, a single model's page, and the two
    handlers those pages call. The operator surface is the three locations below,
    which are opened on purpose so that the pages behind them can answer with the
    site's own 404 rather than the pipeline's sign-in redirect. Two mechanisms, in
    that order: at a location named here, the pipeline decides whether the address
    exists for this site at all, and past it the page decides whether this visitor
    may read it.
  -->
  <location path=".">
    <system.web>
      <authorization>
        <deny users="?" />
      </authorization>
    </system.web>
  </location>

  <!--
    The public face is the four addresses that name themselves over the default: the
    catalogue page, a model's page, and the two handlers those pages call. The two
    pages are opened further down, in the same location elements that exempt them from
    request validation; the two handlers are opened above, beside the note that says
    what each of them may be asked for.
  -->

  <!--
    The operator surface.

    These three are opened here for one reason: a request the request pipeline
    refuses never reaches a page, so the page cannot answer for itself. The site's
    own base page refuses a visitor without a session by answering the site's 404,
    which tells them nothing, and that answer is only possible because the request is
    allowed to arrive. Opening them does not make them readable: it moves the decision
    from the pipeline to the page, where it can be about the visitor rather than about
    the address, and a visitor without a session is answered exactly as they would be
    for an address that does not exist. Every address that is not named in this file
    stays behind the root's deny, which is the net a page added later falls into
    whether or not it thinks about any of this.
  -->
  <location path="Analytics.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Rules.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Admin.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!--
    Request validation is off for the catalogue and for a model's page, and nowhere
    else.

    Both read free text out of their own address: the catalogue carries a search term,
    and a model's page carries an identifier that a person may have typed into the
    address bar by hand. A model's name is allowed to contain an angle bracket and a
    search term is allowed to be anything at all, and the framework would refuse such
    an address with a message about a dangerous value, which is a page that cannot
    be reached by the value it exists to search for.

    Nothing on either page writes a request value into the response without encoding
    it. The search term goes to the API as a bound parameter and comes back as a row
    that the renderer encodes, and the identifier is parsed into a number before it is
    used for anything. That rule holds on every other page of this site as well, which
    is why this exemption is narrow and why the pages that do not read free text keep
    validation on.

    It is declared here rather than on the pages alone because a page-level attribute
    is only honoured when the runtime is configured to honour it. The runtime is set
    to the mode in which validation is applied to the whole request for every page and
    a page may opt out, which is the only mode where a single page can be exempted:
    the newer mode validates each request value as it is read and has no per-page
    opt-out at all.
  -->
  <location path="Default.aspx">
    <system.web>
      <!-- The catalogue is read by anybody, which is what the site is published for. -->
      <authorization>
        <allow users="*" />
      </authorization>
      <pages validateRequest="false" />
    </system.web>
  </location>

  <location path="Model.aspx">
    <system.web>
      <!-- A model's page is reached from the catalogue, so it is read by anybody the catalogue is. -->
      <authorization>
        <allow users="*" />
      </authorization>
      <pages validateRequest="false" />
    </system.web>
  </location>

  <location path="Explorer.aspx">
    <system.web>
      <!--
        The explorer draws the payload the download link on a model's page hands out, so it is read by
        anybody that page is. What it takes from the address is one identifier, which is parsed into a
        number before it is used; no free text reaches this page, so it is exempted from the sign-in
        requirement and from nothing else, and request validation stays on.
      -->
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <!--
          A defence that costs nothing to have in two places. The pages write the same
          policy as a meta element, which travels with the document; these headers
          travel with the response, and one of the two arriving is enough.
        -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="same-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=(), payment=()" />
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!--
        The stylesheet and the script are content-hashed by the build, so they can be
        cached hard. The pages themselves are never cached, because they carry a
        per-session anti-forgery token.
      -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- Refuse oversized or unusually deep requests before they reach the pipeline. -->
        <requestLimits maxAllowedContentLength="2097152" maxUrl="4096" maxQueryString="2048" />
        <hiddenSegments>
          <!--
            App_Data holds the credential database. The entry is removed before it is
            added because IIS already hides App_Data by default, and adding it a second
            time is a duplicate collection entry, which stops the application from
            starting at all rather than quietly doing nothing.
          -->
          <remove segment="App_Data" />
          <add segment="App_Data" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>

</configuration>
