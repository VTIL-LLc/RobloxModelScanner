# =============================================================================
# RMS SCANNER — ENVIRONMENT TEMPLATE
# =============================================================================
# Copy this file to .env in the same directory and fill in the values.
#
# A deployment writes this template and never writes .env. There is no value a
# deployment could write that would be correct: the cookie below belongs to an
# account, and the webhooks below belong to a server, and only the operator has
# either. A service that starts without them is a service that runs and reports
# nothing, which is why the file it needs has a name that says what to do with
# it.
#
# The scanner reads .env from its working directory. A variable set in the
# process environment takes precedence over the same key in this file, which is
# how a deployment supplies the paths: the values it passes win, and this file is
# left to carry only what it must.
#
# An empty value means "leave this setting alone" and the scanner uses the
# default named in the comment above it. A value that is present and wrong is not
# the same as an absent one: the scanner reports it rather than quietly falling
# back.
#
# This file holds a live credential once it is filled in. It is not a file to
# commit, and it is not a file to copy back into the repository.
# =============================================================================

# A Roblox session cookie.
#
# Asset delivery requires an authenticated caller, so without this the scanner
# can still discover models and read the toolbox but cannot fetch a payload.
# Detections are then recorded without their source, and nothing is kept on
# disk.
#
# Paste the whole cookie value. Required for anything other than a
# discovery-only run.
ROBLOX_COOKIE=

# The Discord webhook that receives one message per run summary.
#
# Empty means no summary is posted. The summary is the only unprompted message
# an unconfigured scanner sends, so leaving it empty is how a quiet deployment is
# configured.
MAIN_WEBHOOK=

# The Discord webhook that receives a message about a payload as it is stored.
#
# Kept separate from the summary so the two can be routed to different channels,
# or so that one of them can be left empty: a busy deployment posts many of these
# and one summary.
AUTODOWNLOAD_WEBHOOK=

# =============================================================================
# PATH SETTINGS
# =============================================================================
# A deployment sets all three of these in the service definition, which is why
# they are empty here. They are listed because an operator running the scanner by
# hand has no service definition to read, and these are the settings that decide
# whether a hand-run scanner and a deployed one are looking at the same
# catalogue.
# =============================================================================

# Where discovered models are recorded.
#
# Default: Files/models.json beside the scanner.
# A deployment points this at artifacts/data/models.json, which is also what the
# indexer reads and what the API serves from. Pointing two scanners at different
# files is how a catalogue silently stops growing.
CATALOGUE_PATH=

# Where kept payloads are written.
#
# Default: the scanner's own directory.
# A deployment points this at artifacts/data/models, outside the published
# directory, so that republishing the scanner does not delete the payloads.
MODEL_DIRECTORY=

# The file the control surface reads to pause or stop a run.
#
# Default: Files/control.json beside the scanner.
# The scanner only ever reads this file. Nothing in the deployed stack writes it,
# so a deployed scanner runs until it is stopped as a service.
CONTROL_PATH=

# =============================================================================
# THE PASS
# =============================================================================

# Which pass to run.
#
#   sweep      begin at START_ID and walk upwards, adding what it finds. Additive
#              and idempotent, and the cursor is written back as it goes, so an
#              interrupted sweep resumes instead of starting again.
#   backfill   walk the existing catalogue and repair the rows the toolbox could
#              not describe. Performs no discovery and posts no webhooks, because
#              the number of repairs would be thousands of messages.
#
# Default: sweep. An unrecognised value is also a sweep, because a sweep is
# safe to run by accident and a backfill over the whole catalogue is not.
SCAN_MODE=

# The asset identifier a sweep begins at.
# Default: 16848923941.
START_ID=

# How many identifiers are asked for in one toolbox request.
# Default: 99. The endpoint rejects more than 250.
BATCH_SIZE=

# How many models are inspected at once.
# Default: 16.
SCAN_CONCURRENCY=

# How many payloads are fetched at once.
# Default: 64.
ASSET_CONCURRENCY=

# The shortest gap between two toolbox requests, in milliseconds.
#
# Default: 0, which sends as fast as the batch loop allows.
# The endpoint throttles at roughly two requests per second; 1200 has been
# measured running 18 batches in 21 seconds with no refusals at all. A refused
# request is retried, so this setting trades wall-clock time for a clean log.
REQUEST_INTERVAL_MS=

# How often the catalogue is written back, in seconds.
# Default: 15.
FLUSH_SECONDS=

# How many newly discovered models are held before the catalogue is written.
# Default: 250.
#
# Both this and FLUSH_SECONDS are armed at once and whichever fires first writes
# the file, so a slow sweep still saves periodically and a fast one does not hold
# an unbounded amount in memory.
FLUSH_ROWS=

# The lowest score for which a payload is kept on disk.
# Default: 3.
KEEP_SCORE=

# Whether to keep payloads at all.
# Default: true. A discovery-only deployment sets this to false and keeps no
# model files.
KEEP_MODELS=

# The creators whose models are skipped, comma separated.
#
# Empty means the built-in default set. A configured list replaces that set
# entirely rather than extending it, so re-including a default here is how it is
# put back.
IGNORED_CREATORS=

# Log every inspection rather than only the ones that matched.
# Default: false.
VERBOSE=
